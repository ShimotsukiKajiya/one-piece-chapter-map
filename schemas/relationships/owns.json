{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shimotsukicodex.com/schemas/relationships/owns.json",
  "title": "owns relationship",
  "description": "character → weapon/item. Tracks ownership history: when acquired, when relinquished, who from, what happened.",
  "type": "object",
  "required": ["from", "to", "src"],
  "properties": {
    "from": {"$ref": "../_common.json#/$defs/character_id"},
    "to": {
      "oneOf": [
        {"$ref": "../_common.json#/$defs/weapon_id"},
        {"$ref": "../_common.json#/$defs/item_id"}
      ]
    },
    "src":        {"$ref": "../_common.json#/$defs/src"},
    "since":      {"$ref": "../_common.json#/$defs/chapter_id"},
    "until":      {"oneOf": [{"$ref": "../_common.json#/$defs/chapter_id"}, {"type": "null"}]},
    "current":    {"type": "boolean"},
    "from_owner": {"oneOf": [{"$ref": "../_common.json#/$defs/character_id"}, {"type": "null"}]},
    "fate":       {"type": ["string", "null"]},
    "tier":       {"$ref": "../_common.json#/$defs/tier"},
    "evidence":   {
      "type": "array",
      "items": {"$ref": "../_common.json#/$defs/evidence_ref"}
    }
  },
  "additionalProperties": false
}
