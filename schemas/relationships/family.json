{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shimotsukicodex.com/schemas/relationships/family.json",
  "title": "family relationship",
  "description": "character → character. Bidirectional but stored once — the resolver expands. A 'parent' row implies a 'child' row in reverse.",
  "type": "object",
  "required": ["from", "to", "src", "relation"],
  "properties": {
    "from":     {"$ref": "../_common.json#/$defs/character_id"},
    "to":       {"$ref": "../_common.json#/$defs/character_id"},
    "src":      {"$ref": "../_common.json#/$defs/src"},
    "relation": {"$ref": "../_common.json#/$defs/family_relation"},
    "chapter": {
      "description": "Manga chapter that confirms this relationship (raw integer).",
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "description": "Free-text citation for non-chapter sources (films, SBS references, etc.).",
      "type": "string"
    },
    "tier":     {"$ref": "../_common.json#/$defs/tier"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "../_common.json#/$defs/evidence_ref"}
    }
  },
  "additionalProperties": false
}
