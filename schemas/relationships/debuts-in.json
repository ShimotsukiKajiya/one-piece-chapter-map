{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shimotsukicodex.com/schemas/relationships/debuts-in.json",
  "title": "debuts-in relationship",
  "description": "any entity → chapter. Subset of appears-in (the earliest row), stored separately so 'when does X first appear?' doesn't need a min-aggregation.",
  "type": "object",
  "required": ["from", "to", "src"],
  "properties": {
    "from":            {"$ref": "../_common.json#/$defs/entity_id"},
    "to":              {"$ref": "../_common.json#/$defs/chapter_id"},
    "src":             {"$ref": "../_common.json#/$defs/src"},
    "appearance_type": {"$ref": "../_common.json#/$defs/appearance_type"},
    "tier":            {"$ref": "../_common.json#/$defs/tier"},
    "evidence":        {
      "type": "array",
      "items": {"$ref": "../_common.json#/$defs/evidence_ref"}
    }
  },
  "additionalProperties": false
}
