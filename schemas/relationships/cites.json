{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shimotsukicodex.com/schemas/relationships/cites.json",
  "title": "cites relationship",
  "description": "theory → sbs / chapter. Captures a theory's evidence chain. 'stance' records whether the cited evidence supports, refutes, or merely mentions the theory's claim.",
  "type": "object",
  "required": ["from", "to", "src", "stance"],
  "properties": {
    "from": {"$ref": "../_common.json#/$defs/theory_id"},
    "to": {
      "oneOf": [
        {"$ref": "../_common.json#/$defs/sbs_id"},
        {"$ref": "../_common.json#/$defs/chapter_id"}
      ]
    },
    "src":    {"$ref": "../_common.json#/$defs/src"},
    "stance": {"$ref": "../_common.json#/$defs/stance"}
  },
  "additionalProperties": false
}
