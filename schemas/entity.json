{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shimotsukicodex.com/schemas/entity.json",
  "title": "Entity record",
  "description": "An entity in the Codex (character, fruit, crew, location, etc.). Required fields per docs/id-system.md §The entity record.",
  "type": "object",
  "required": ["id", "name", "slug", "aliases", "type"],
  "properties": {
    "id":          {"$ref": "_common.json#/$defs/entity_id"},
    "name":        {"type": "string", "minLength": 1},
    "slug":        {"$ref": "_common.json#/$defs/slug"},
    "name_jp":     {"type": "string"},
    "name_romaji": {"type": "string"},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": false
    },
    "type": {
      "type": "string",
      "enum": [
        "character", "fruit", "crew", "location", "ship",
        "weapon", "item", "material", "race", "technique", "voice_actor",
        "chapter", "episode", "volume", "sbs", "theory", "saga", "arc"
      ]
    }
  },
  "additionalProperties": true
}
